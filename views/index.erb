<section class="page-heading">
  <div>
    <p class="eyebrow">REQUEST OVERVIEW</p>
    <h1>Rails activity</h1>
    <p class="muted">A quick view of traffic and the latest requests.</p>
  </div>
  <a class="button secondary" href="/requests">Browse all requests <span aria-hidden="true">→</span></a>
</section>

<section class="panel overview-panel">
  <div class="section-heading">
    <div>
      <p class="eyebrow">TRAFFIC</p>
      <h2>Requests over the last <%= h(@timeframe[:label]) %></h2>
    </div>
    <span class="live-dot">Request volume</span>
  </div>
  <div class="stats-grid">
    <article class="stat-card">
      <span class="stat-label">Requests</span>
      <strong><%= @summary["count"].to_i %></strong>
      <span class="stat-note">in this timeframe</span>
    </article>
    <article class="stat-card">
      <span class="stat-label">Average response</span>
      <strong><%= @summary["average_total"] ? "#{@summary["average_total"].round} ms" : "—" %></strong>
      <span class="stat-note">completed requests</span>
    </article>
    <article class="stat-card">
      <span class="stat-label">View rendering</span>
      <strong><%= @summary["views"].to_i %><small> ms</small></strong>
      <span class="stat-note">combined view time</span>
    </article>
    <article class="stat-card">
      <span class="stat-label">Database</span>
      <strong><%= @summary["database"].to_i %><small> ms</small></strong>
      <span class="stat-note">combined Active Record time</span>
    </article>
  </div>

  <div class="chart" role="img" aria-label="Requests per time bucket">
    <% @chart.each do |bucket| %>
      <div class="chart-column" title="<%= h(bucket[:title]) %>: <%= bucket[:count] %> requests">
        <span class="chart-count"><%= bucket[:count].positive? ? bucket[:count] : "" %></span>
        <div class="bar-track"><div class="bar" style="height: <%= bucket[:count].zero? ? 0 : [bucket[:count].to_f / @chart_max * 100, 5].max %>%"></div></div>
        <span class="chart-label"><%= h(bucket[:label]) %></span>
      </div>
    <% end %>
  </div>
  <div class="timeframes" aria-label="Choose chart timeframe">
    <span>Show:</span>
    <% LogExplorer::TIMEFRAMES.each do |key, timeframe| %>
      <a class="timeframe <%= "selected" if key == @timeframe_key %>" href="/?range=<%= key %>" <%= "aria-current=page" if key == @timeframe_key %>><%= h(timeframe[:label]) %></a>
    <% end %>
  </div>
</section>

<section class="requests-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">LATEST ACTIVITY</p>
      <h2>Recent requests <span class="count-pill"><%= @requests.length %></span></h2>
      <p class="muted">Select a request to inspect its log entries.</p>
    </div>
    <a class="text-link" href="/requests">More requests <span aria-hidden="true">→</span></a>
  </div>
  <%= erb :request_table, layout: false, locals: { requests: @requests } %>
</section>